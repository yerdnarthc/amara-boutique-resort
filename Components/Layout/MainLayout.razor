@inherits LayoutComponentBase

<MudThemeProvider Theme="AmaraTheme.Theme" IsDarkMode="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<a class="skip-link" href="#main-content">Skip to content</a>
<div class="site-frame">
    <header class="site-header">
        <NavLink class="brand" href="" Match="NavLinkMatch.All" aria-label="Amara home">
            <span class="brand-name">amara<span class="brand-dot">.</span></span>
            <span class="brand-description">STAYS &amp; EXPERIENCES</span>
        </NavLink>
        <button type="button" class="menu-toggle" aria-controls="site-navigation"
                aria-expanded="@(_menuOpen ? "true" : "false")" aria-label="Toggle navigation" @onclick="ToggleMenu">
            <MudIcon Icon="@(_menuOpen ? Icons.Material.Filled.Close : Icons.Material.Filled.Menu)" />
            <span>Menu</span>
        </button>
        <nav id="site-navigation" class="site-navigation @(_menuOpen ? "is-open" : "")" aria-label="Main navigation">
            <NavLink href="" Match="NavLinkMatch.All" @onclick="CloseMenu">Home</NavLink>
            <NavLink href="rooms" @onclick="CloseMenu">Rooms</NavLink>
            <NavLink href="experiences" @onclick="CloseMenu">Experiences</NavLink>
            <NavLink href="bookings" @onclick="CloseMenu">My bookings</NavLink>
            <NavLink href="book" class="nav-book" @onclick="CloseMenu">Book a stay <MudIcon Icon="@Icons.Material.Filled.NorthEast" Size="Size.Small" /></NavLink>
        </nav>
    </header>
    <main id="main-content" tabindex="-1">
        @Body
    </main>
    <footer class="site-footer">
        <a class="footer-wordmark" href="">amara.</a>
        <p>A place to stay. A little more to discover.</p>
        <span>Fictional resort · Demonstration only</span>
    </footer>
</div>
<div id="blazor-error-ui" role="alert">
    The connection was interrupted. <a href="">Reload the page</a> to reconnect.
</div>

@code {
    private bool _menuOpen;
    private void ToggleMenu() => _menuOpen = !_menuOpen;
    private void CloseMenu() => _menuOpen = false;
}