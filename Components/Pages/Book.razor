@page "/book"
@inject BookingState Booking
<PageTitle>Book a stay - Amara</PageTitle>
<div class="page-container">
    <PageIntro Title="Make yourself at home." Description="Review the room, dates, and guests for your stay." />
    @if (_room is null || _stay is null)
    {
        <EmptyState Icon="@Icons.Material.Outlined.CalendarMonth" Title="Choose your room first" Description="@_selectionMessage" ActionText="Browse rooms" ActionHref="rooms" />
    }
    else
    {
        <section class="selected-stay" aria-labelledby="selected-room-title">
            <img src="@_room.ImagePath" alt="@_room.ImageAlt" width="960" height="640" />
            <div class="selected-stay-content">
                <h2 id="selected-room-title">@_room.Name</h2>
                <p>@_room.Type · @_room.Bed · Up to @_room.Capacity guests</p>
                <dl class="stay-facts">
                    <div><dt>Check-in</dt><dd>@_stay.CheckIn.ToString("dd MMM yyyy")</dd></div>
                    <div><dt>Check-out</dt><dd>@_stay.CheckOut.ToString("dd MMM yyyy")</dd></div>
                    <div><dt>Guests</dt><dd>@_stay.Guests</dd></div>
                    <div><dt>Nightly rate</dt><dd>@BookingState.Money(_room.NightlyRate)</dd></div>
                </dl>
                <div class="stay-total"><span>@_stay.Nights @(_stay.Nights == 1 ? "night" : "nights") × @BookingState.Money(_room.NightlyRate)</span><strong>@BookingState.Money(_room.NightlyRate * _stay.Nights)</strong></div>
                <p class="session-note">Your room is selected, but has not been reserved. Reservation submission is not available yet. All rates and rooms are demonstration only.</p>
                <MudButton Href="rooms" Variant="Variant.Outlined" Color="Color.Default">Choose another room</MudButton>
            </div>
        </section>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "roomId")] public string? RoomId { get; set; }
    [SupplyParameterFromQuery(Name = "checkIn")] public string? CheckIn { get; set; }
    [SupplyParameterFromQuery(Name = "checkOut")] public string? CheckOut { get; set; }
    [SupplyParameterFromQuery(Name = "guests")] public string? Guests { get; set; }
    private Room? _room;
    private RoomSearch? _stay;
    private string _selectionMessage = "Start with the room collection, choose your dates and guests, then select an available room.";

    protected override void OnParametersSet()
    {
        _room = null;
        _stay = null;
        _selectionMessage = "Start with the room collection, choose your dates and guests, then select an available room.";
        if (RoomId is null) return;
        if (!int.TryParse(RoomId, out var id) || Booking.FindRoom(id) is not { } room ||
            !DateOnly.TryParseExact(CheckIn, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var start) ||
            !DateOnly.TryParseExact(CheckOut, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var end) ||
            !int.TryParse(Guests, out var guests) || guests < 1 || guests > room.Capacity ||
            start < DateOnly.FromDateTime(DateTime.Today) || end <= start)
        {
            _selectionMessage = "This room selection is incomplete or invalid. Choose a room with valid dates and a guest count within its capacity.";
            return;
        }
        if (!Booking.IsAvailable(id, start, end))
        {
            _selectionMessage = "This room is unavailable for those dates. Change your dates or choose another room.";
            return;
        }
        _room = room;
        _stay = new RoomSearch { CheckIn = start, CheckOut = end, Guests = guests };
    }
}