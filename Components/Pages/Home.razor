@page "/"
@inject BookingState Booking
@inject NavigationManager Navigation
<PageTitle>Amara - Stays &amp; Experiences</PageTitle>

<section class="home-hero" aria-labelledby="home-title">
    <div class="hero-copy">
        <h1 id="home-title">Stay a while.<br />Discover <span>more.</span></h1>
        <p>Make room for a slower morning, a walk somewhere new, and time together. Find your stay at Amara, then explore what lies beyond it.</p>
        <div class="hero-actions">
            <MudButton Href="rooms" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" DropShadow="false" EndIcon="@Icons.Material.Filled.ArrowForward">Explore rooms</MudButton>
            <a class="text-link" href="experiences">Discover experiences</a>
        </div>
        <div class="hero-note">
            <MudIcon Icon="@Icons.Material.Outlined.WbSunny" Size="Size.Small" />
            <span>Space to settle in. Reasons to step outside.</span>
        </div>
    </div>
    <figure class="hero-image">
        <img src="images/resort.jpg" width="1200" height="1500" alt="An illuminated resort terrace reflected in a swimming pool at dusk" fetchpriority="high" />
        <figcaption>Your next chapter starts with a little space.</figcaption>
    </figure>
</section>
<section class="home-search" aria-labelledby="home-search-title">
    <div><h2 id="home-search-title">Find your stay</h2><p>Choose dates and guests to see available rooms.</p></div>
    <EditForm Model="_search" OnValidSubmit="FindRooms" FormName="home-search" novalidate>
        <DataAnnotationsValidator />
        <div class="filter-field"><label for="home-check-in">Check-in</label><InputDate id="home-check-in" @bind-Value="_search.CheckIn" min="@TodayIso" /><ValidationMessage For="() => _search.CheckIn" /></div>
        <div class="filter-field"><label for="home-check-out">Check-out</label><InputDate id="home-check-out" @bind-Value="_search.CheckOut" min="@CheckOutMinimum" /><ValidationMessage For="() => _search.CheckOut" /></div>
        <div class="filter-field"><label for="home-guests">Guests</label><InputNumber id="home-guests" @bind-Value="_search.Guests" min="1" max="6" /><ValidationMessage For="() => _search.Guests" /></div>
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" DropShadow="false">Find rooms</MudButton>
    </EditForm>
</section>
<section class="home-featured" aria-labelledby="featured-rooms-title">
    <div class="section-heading"><div><h2 id="featured-rooms-title">Find room to settle in.</h2><p>Find a space that feels right for your stay.</p></div><a class="text-link" href="rooms">All rooms <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" /></a></div>
    <div class="home-featured-grid">
        @foreach (var room in Booking.Rooms.Take(2))
        {
            <article class="home-featured-card"><img src="@room.ImagePath" alt="@room.ImageAlt" width="960" height="640" loading="lazy" /><div><h3>@room.Name</h3><p>@room.Description</p><span>@BookingState.Money(room.NightlyRate) per night · Up to @room.Capacity guests</span></div></article>
        }
    </div>
</section>
<section class="home-experiences" aria-labelledby="home-experiences-title"><div><h2 id="home-experiences-title">Make more of the day.</h2><p>Explore cultural walks, nature outings, and guided adventures. See each itinerary before you go.</p><a class="text-link" href="experiences">Explore experiences <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" /></a></div></section>
<section class="welcome-strip" aria-labelledby="welcome-title">
    <h2 id="welcome-title">A stay that leaves<br />room for you.</h2>
    <div>
        <p>Begin with somewhere to call your own. Fill the rest with local discoveries, or leave the afternoon open.</p>
        <a class="text-link" href="rooms">Find your room <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" /></a>
    </div>
</section>

@code {
    private RoomSearch _search = new();
    private string TodayIso => DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd");
    private string CheckOutMinimum => (_search.CheckIn < DateOnly.MaxValue ? _search.CheckIn.AddDays(1) : _search.CheckIn).ToString("yyyy-MM-dd");
    private void FindRooms() => Navigation.NavigateTo($"rooms?checkIn={_search.CheckIn:yyyy-MM-dd}&checkOut={_search.CheckOut:yyyy-MM-dd}&guests={_search.Guests}");
}
