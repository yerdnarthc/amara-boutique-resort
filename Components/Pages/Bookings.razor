@page "/bookings"
@inject BookingState Booking
@inject IDialogService DialogService
<PageTitle>My bookings - Amara</PageTitle>
<div class="page-container">
    <PageIntro Title="Your time at Amara." Description="Review your stay details, find a reservation, or cancel a stay you no longer need." />
    @if (Booking.Reservations.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Outlined.Luggage" Title="No stays booked yet" Description="Your reservations will appear here after you book. Explore the rooms to begin planning your stay." ActionText="Explore rooms" ActionHref="rooms" />
    }
    else
    {
        <div class="booking-filters">
            <div class="filter-field"><label for="booking-search">Find a reservation</label><input id="booking-search" type="search" placeholder="Name, room, email, or reference" @bind="_search" @bind:event="oninput" /></div>
            <div class="filter-field"><label for="booking-status">Status</label><select id="booking-status" @bind="_status"><option value="All">All reservations</option><option value="Confirmed">Confirmed</option><option value="Cancelled">Cancelled</option></select></div>
            <MudButton OnClick="ClearFilters" Color="Color.Default">Clear filters</MudButton>
        </div>
        <p class="booking-result-count" role="status" aria-live="polite">@FilteredReservations.Count of @Booking.Reservations.Count @(Booking.Reservations.Count == 1 ? "reservation" : "reservations")</p>
    }
    @if (_feedback is not null) { <p class="booking-feedback" role="status">@_feedback</p> }
    @if (_error is not null) { <div class="booking-error" role="alert">@_error</div> }
    @if (Booking.Reservations.Count > 0)
    {
        @if (FilteredReservations.Count == 0)
        {
            <section class="empty-state"><h2>No reservations match</h2><p>Try another name or reference, or clear the filters to see every reservation.</p><MudButton Color="Color.Primary" Variant="Variant.Filled" DropShadow="false" OnClick="ClearFilters">Show all reservations</MudButton></section>
        }
        else
        {
            <div class="managed-bookings" aria-label="Reservations">
                @foreach (var reservation in FilteredReservations)
                {
                    <article class="booking-entry" aria-labelledby="booking-@reservation.Reference" data-reference="@reservation.Reference">
                        <div class="booking-entry-title"><h2 id="booking-@reservation.Reference">@reservation.RoomName</h2><p class="booking-entry-reference">@reservation.Reference</p><p>@reservation.GuestName</p></div>
                        <dl class="booking-entry-facts">
                            <div><dt>Stay dates</dt><dd>@reservation.CheckIn.ToString("dd MMM yyyy")<br />@reservation.CheckOut.ToString("dd MMM yyyy")</dd></div>
                            <div><dt>@(reservation.Status == ReservationStatus.Cancelled ? "Original quote" : "Total")</dt><dd>@BookingState.Money(reservation.Total)</dd></div>
                            <div><dt>Status</dt><dd class="reservation-status @(reservation.Status == ReservationStatus.Cancelled ? "is-cancelled" : "is-confirmed")">@reservation.Status</dd></div>
                        </dl>
                        <div class="booking-entry-actions">
                            <MudButton Color="Color.Default" Variant="Variant.Outlined" OnClick="() => ShowDetails(reservation)" aria-label="@($"View reservation {reservation.Reference}")">View details</MudButton>
                            <MudButton Color="Color.Default" Class="cancel-action" Disabled="@(_isCancelling || reservation.Status == ReservationStatus.Cancelled)" OnClick="() => CancelReservation(reservation)" aria-label="@($"Cancel reservation {reservation.Reference}")">@(reservation.Status == ReservationStatus.Cancelled ? "Cancelled" : "Cancel stay")</MudButton>
                        </div>
                    </article>
                }
            </div>
        }
    }
    <p class="session-note">Reservations are available only during this visit and may be lost if you refresh or close the site.</p>
</div>
@code {
    private string _search = string.Empty;
    private string _status = "All";
    private bool _isCancelling;
    private string? _feedback;
    private string? _error;
    private List<Reservation> FilteredReservations
    {
        get
        {
            var term = _search.Trim();
            return Booking.Reservations.Where(item =>
                (_status == "All" || item.Status.ToString() == _status) &&
                (term.Length == 0 || item.Reference.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                 item.GuestName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                 item.RoomName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                 item.Email.Contains(term, StringComparison.OrdinalIgnoreCase)))
                .OrderByDescending(item => item.CreatedAt).ToList();
        }
    }
    private void ClearFilters() { _search = string.Empty; _status = "All"; }
    private async Task ShowDetails(Reservation reservation)
    {
        var current = Booking.FindReservation(reservation.Reference);
        if (current is null) { _error = "We couldn't find that reservation. It may have been cleared after a refresh or restart."; return; }
        var parameters = new DialogParameters<ReservationDetailsDialog> { { dialog => dialog.Reservation, current } };
        await DialogService.ShowAsync<ReservationDetailsDialog>("Reservation details", parameters,
            new DialogOptions { CloseButton = true, CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Small });
    }
    private async Task CancelReservation(Reservation reservation)
    {
        if (_isCancelling || reservation.Status == ReservationStatus.Cancelled) return;
        _isCancelling = true;
        _feedback = null;
        _error = null;
        try
        {
            var parameters = new DialogParameters<CancelReservationDialog> { { dialog => dialog.Reservation, reservation } };
            var dialog = await DialogService.ShowAsync<CancelReservationDialog>("Cancel this reservation?", parameters,
                new DialogOptions { CloseButton = true, CloseOnEscapeKey = true, BackdropClick = false, FullWidth = true, MaxWidth = MaxWidth.Small });
            var result = await dialog.Result;
            if (result is { Canceled: false, Data: true })
            {
                if (Booking.TryCancel(reservation.Reference, out var error))
                    _feedback = $"Reservation {reservation.Reference} was cancelled. Its dates have been released.";
                else _error = error;
            }
        }
        finally { _isCancelling = false; }
    }
}
