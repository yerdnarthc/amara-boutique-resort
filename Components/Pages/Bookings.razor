@page "/bookings"
@inject BookingState Booking
<PageTitle>My bookings - Amara</PageTitle>
<div class="page-container">
    <PageIntro Title="Your time at Amara." Description="Keep your stay details together, from arrival dates to reservation references." />
    @if (Booking.Reservations.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Outlined.Luggage" Title="No stays booked yet" Description="Your reservations will appear here after you book. Explore the rooms to begin planning your stay." ActionText="Explore rooms" ActionHref="rooms" />
    }
    else
    {
        <ul class="reservation-links" aria-label="Session reservations">
            @foreach (var reservation in Booking.Reservations.OrderByDescending(item => item.CreatedAt))
            {
                <li><div><h2>@reservation.RoomName</h2><p>@reservation.CheckIn.ToString("dd MMM yyyy") – @reservation.CheckOut.ToString("dd MMM yyyy") · @reservation.Reference</p></div><a class="text-link" href="@($"book?reference={reservation.Reference}")">View confirmation</a></li>
            }
        </ul>
    }
    <p class="session-note">These fictional reservations are held only in the current session and may reset when you refresh or restart.</p>
</div>