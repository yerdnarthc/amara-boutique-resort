    "narrative":  {
                      "northStar":  "Room to unwind",
                      "overview":  "Amara combines warm paper, charcoal type, restrained terracotta actions, and destination photography. The visual direction follows the approved Anthropic palette and Poppins/Lora pairing; it expresses a fictional hospitality brand through generous space and calm editorial composition.\n\nPoppins gives headings and navigation a clear, contemporary voice. Lora makes descriptive copy feel unhurried. Thin rules and shared background tones organize the interface without decorative depth. Room browsing and selected-stay review extend this foundation with quiet native fields, photographic cards, and a focused details dialog.",
                      "keyCharacteristics":  [
                                                 "Warm paper surfaces with charcoal text.",
                                                 "Regular-weight Poppins headings and Lora reading copy.",
                                                 "Terracotta actions with dark, readable labels.",
                                                 "Thin separators, gently rounded containers, and local photography.",
                                                 "Responsive navigation and visible keyboard focus."
                                             ],
                      "rules":  [
                                    {
                                        "section":  "colors",
                                        "body":  "Terracotta filled actions use charcoal labels, matching the configured primary contrast color.",
                                        "name":  "The Dark Label Rule"
                                    },
                                    {
                                        "section":  "typography",
                                        "body":  "Use Poppins for headings and controls, and Lora for descriptive body copy.",
                                        "name":  "The Two Voice Rule"
                                    },
                                    {
                                        "section":  "elevation",
                                        "body":  "Separate foundation sections with spacing and hairlines before introducing elevation.",
                                        "name":  "The Quiet Surface Rule"
                                    }
                                ],
                      "dos":  [
                                  "Do keep warm paper and charcoal as the dominant surface and text pairing.",
                                  "Do use Poppins for headings and controls, and Lora for descriptive copy.",
                                  "Do retain dark labels on terracotta filled actions.",
                                  "Do preserve the shared container, mobile stacking, and visible keyboard outlines.",
                                  "Do use real SVG icons and credited local illustrative photography."
                              ],
                      "donts":  [
                                    "Don\u0027t replace the approved palette or typography when adding a screen.",
                                    "Don\u0027t add decorative gradients, heavy shadows, or unnecessary animation to this restrained foundation.",
                                    "Don\u0027t document unimplemented inputs, cards, or dialogs as established patterns.",
                                    "Don\u0027t use muted decorative brand colors for low-contrast body text."
                                ]
                  }
